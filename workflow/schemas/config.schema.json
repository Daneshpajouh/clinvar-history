{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "clinvar-history build configuration",
  "type": "object",
  "required": [
    "clinvar",
    "panel",
    "gnomad",
    "mavedb"
  ],
  "properties": {
    "clinvar": {
      "type": "object",
      "required": [
        "base_url",
        "releases",
        "assembly"
      ],
      "properties": {
        "base_url": {
          "type": "string",
          "pattern": "^(ftp|https)://"
        },
        "releases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}$"
          },
          "uniqueItems": true
        },
        "assembly": {
          "enum": [
            "GRCh38"
          ]
        }
      }
    },
    "panel": {
      "type": "object",
      "required": [
        "genes",
        "ensembl_lookup_url",
        "flank_bp"
      ],
      "properties": {
        "genes": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "pattern": "^[A-Z0-9-]+$"
          }
        },
        "ensembl_lookup_url": {
          "type": "string"
        },
        "flank_bp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        }
      }
    },
    "gnomad": {
      "type": "object",
      "required": [
        "release",
        "dataset",
        "url_template",
        "ancestry_groups"
      ],
      "properties": {
        "release": {
          "type": "string"
        },
        "dataset": {
          "enum": [
            "joint",
            "exomes",
            "genomes"
          ]
        },
        "url_template": {
          "type": "string",
          "pattern": "\\{chrom\\}"
        },
        "ancestry_groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "mavedb": {
      "type": "object",
      "required": [
        "api",
        "score_sets"
      ],
      "properties": {
        "api": {
          "type": "string"
        },
        "score_sets": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "urn",
              "gene",
              "match_level"
            ],
            "properties": {
              "urn": {
                "type": "string",
                "pattern": "^urn:mavedb:[0-9]{8}-[0-9a-z]+-[0-9]+$"
              },
              "gene": {
                "type": "string"
              },
              "match_level": {
                "enum": [
                  "nucleotide",
                  "protein"
                ]
              }
            }
          }
        }
      }
    }
  }
}
